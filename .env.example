# Generate a private random value of at least 32 characters. Never commit .env.
JWT_SECRET=
DATABASE_URL=sqlite:///./banking.db
SIMULATION_ONLY=true
POLICY_VERSION=simulation-v1
# Required only by explicit seed provisioning; at least 12 characters.
DEMO_PASSWORD=
# Docker Compose PostgreSQL password (not used by SQLite).
POSTGRES_PASSWORD=
